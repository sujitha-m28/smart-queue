# Smart Trial Room — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ========================
# Database Configuration
# ========================
POSTGRES_DB=trialroom_db
POSTGRES_USER=trialroom
POSTGRES_PASSWORD=trialroom_secure_pass_2024

# Used by Spring Boot (when running locally, point to localhost:5432)
DB_URL=jdbc:postgresql://postgres:5432/trialroom_db
DB_USERNAME=trialroom
DB_PASSWORD=trialroom_secure_pass_2024

# ========================
# JWT Configuration
# ========================
# Must be at least 256 bits (32 characters) Base64-encoded
# Generate with: openssl rand -base64 32
JWT_SECRET=VGhpcyBpcyBhIHZlcnkgbG9uZyBzZWNyZXQga2V5IGZvciBKV1QgdGhhdCBpcyBhdCBsZWFzdCAyNTYgYml0cyBsb25n
JWT_EXPIRATION_MS=86400000

# ========================
# AI Configuration
# ========================
# Set your OpenAI or Google Gemini API key here
# For OpenAI: get from https://platform.openai.com/api-keys
# For Gemini: get from https://aistudio.google.com/app/apikey
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
# Supported: openai, gemini (requires changing spring-ai dependency)

# ========================
# CORS Configuration
# ========================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:80

# ========================
# Notification Provider
# ========================
# Options: mock (default), email, sms
# mock: logs notifications to console and database (no real messages sent)
# email: requires SMTP configuration below
# sms: requires Twilio configuration below
NOTIFICATION_PROVIDER=mock

# SMTP (for email notifications — only if NOTIFICATION_PROVIDER=email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Twilio (for SMS — only if NOTIFICATION_PROVIDER=sms)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ========================
# Frontend URL
# ========================
FRONTEND_BASE_URL=http://localhost:4200
